local mode = 0
-- 0 = none, 1 = menu, 2 = talking
local npc = {}
local npcs = require("assets.scripts.npcs")

local index = 1

function init(self)
	-- Add initialization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function openMenu()
	gui.animate(gui.get_node("menu"), "position.x", 150, gui.EASING_LINEAR, 1, 0, function()
		msg.post(".", "acquire_input_focus")
	end)
end

function closeMenu()
	msg.post(".", "release_input_focus")
	gui.animate(gui.get_node("menu"), "position.x", -150, gui.EASING_LINEAR, 1)
end

function openText()
	gui.set_enabled(gui.get_node("talking"), true)
	msg.post(".", "acquire_input_focus")
end

function closeText()
	gui.set_enabled(gui.get_node("talking"), false)
	msg.post(".", "release_input_focus")
	npcs.offNpc(true)
end

function setText(text, order)
	gui.set_text(gui.get_node("name"), text[1])
	gui.set_text(gui.get_node("text"), text[order + 1])
end

function on_message(self, message_id, message, sender)
	if message_id == hash("menu") then
		if message[1] then
			mode = 1
			openMenu()
		else
			closeMenu()
		end
	elseif message_id == hash("talk") then
		mode = 2
		index = 1
		npc = npcs.getNpcs(message[1][2])
		setText(npc, index)
		openText()
	end
end

function on_input(self, action_id, action)
	if mode == 1 then

	elseif mode == 2 then
		if action_id == hash("action1") and action.pressed then
			index = index + 1
			if index ~= #npc then
				setText(npc, index)
			else
				closeText()
			end
		end
	end
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
