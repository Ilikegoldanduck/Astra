function openMenu()
	gui.animate(gui.get_node("menu"), "position.x", 150, gui.EASING_LINEAR, 1, 0, function()
		msg.post(".", "acquire_input_focus")
	end)
end

function closeMenu()
	msg.post(".", "release_input_focus")
	gui.animate(gui.get_node("menu"), "position.x", -150, gui.EASING_LINEAR, 1)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("menu") then
		if message[1] then
			mode = 1
			openMenu()
		else
			closeMenu()
		end
	elseif message_id == hash("talk") then
		mode = 2
		npc = message[1]
	end
end

