go.property("held", false)

function fixed_update(self, dt)
	if self.held then
		sprite.play_flipbook(".", "plateDown")
	else
		sprite.play_flipbook(".", "plateUp")
	end
	msg.post("/interactables#ch1", "interact", {self.held})
	self.held = false
end

function on_message(self, message_id, message, sender)
	if message_id == hash("contact_point_response") then
		self.held = true
	end
end