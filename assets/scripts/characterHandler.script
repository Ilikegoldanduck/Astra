local velocity = vmath.vector3()
local moveMulti = 1

local roll = false
local rollCd = false
local menuCd = true
local text = false

local interact = {"", ""}

-- true = normal false = astral
local phase = true

local inputTable = {
	false,
	false,
	false,
	false
}

local function sign(n)
	if n > 0 then
		return 1
	elseif n < 0 then
		return -1
	else
		return 0
	end
end

local function move(vel)
	if math.sqrt(vel.x ^ 2 + vel.y ^ 2) > 0 then
		if vel.x ~= 0 then
			local xHit = physics.raycast(go.get_position(), go.get_position() + vmath.vector3(vel.x + (sign(vel.x) * 10), 0, 0), {hash("wall")})
			if xHit and ((phase and xHit.id == hash("/normalWall")) or (not phase and xHit.id == hash("/astralWall"))) then
				vel.x = sign(vel.x) * ((math.abs(vel.x) + 10) * xHit.fraction - 10)
			end
		end
		if vel.y ~= 0 then
			local yHit = physics.raycast(go.get_position(), go.get_position() + vmath.vector3(0, vel.y + (sign(vel.y) * 10), 0), {hash("wall")})
			if yHit and ((phase and yHit.id == hash("/normalWall")) or (not phase and yHit.id == hash("/astralWall"))) then
				vel.y = sign(vel.y) * ((math.abs(vel.y) + 10) * yHit.fraction - 10)
			end
		end
		go.set_position(go.get_position() + vel)
	end
end

function init(self)
	msg.post("/go#camera", "acquire_camera_focus")
	msg.post(".", "acquire_input_focus")
	velocity = vmath.vector3()
	playerPos = vmath.vector3()

end

