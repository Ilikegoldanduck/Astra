	-- Remove this function if not needed
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	if menu then

	elseif roll then
		move(velocity * 3)
	else
		velocity.x = 0
		velocity.y = 0
		if inputTable[1] and inputTable[2] then

		elseif inputTable[1] then
			velocity.y = velocity.y + 5
		elseif inputTable[2] then
			velocity.y = velocity.y - 5
		end
		if inputTable[3] and inputTable[4] then

		elseif inputTable[3] then
			velocity.x = velocity.x - 5
		elseif inputTable[4] then
			velocity.x = velocity.x + 5
		end
		move(velocity)
		inWall = false
	end
end

local inWall = false

function on_message(self, message_id, message, sender)
	if message_id == hash("contact_point_response") then
		if message.group == hash("wall") and math.floor(message.distance) > 0 then
			inWall = true
			if phase and message.group == hash("/normalWall") then
				go.set_position(go.get_position() + (message.normal * message.distance))
			elseif not phase and message.other_id == hash("/astralWall") then
				go.set_position(go.get_position() + (message.normal * message.distance))
			end
		else
			inWall = false
		end
		if phase and message.group == hash("npc") then
			interact[1] = "npc"
			interact[2] = message.other_id
		elseif message.group == hash("interact") then
			interact[1] = "interact"
			interact[2] = message.other_id
		else
			interact[1] = ""
			interact[2] = ""
		end
	elseif message_id == hash("text") then
		text = false
	end
end

--inputTable 1 = up 2 = down 3 = left 4 = right

local a1 = vmath.vector3(-1, -1, 0)
local a2 = vmath.vector3(1, 1, 0)

function on_input(self, action_id, action)
	if action_id == hash("up") then
		if action.pressed then
			inputTable[1] = true
		elseif action.released then
			inputTable[1] = false
		end
	elseif action_id == hash("down") then
		if action.pressed then
			inputTable[2] = true
		elseif action.released then
			inputTable[2] = false
		end
	end
	if action_id == hash("left") then
		if action.pressed then
			inputTable[3] = true
		elseif action.released then
			inputTable[3] = false
		end
	elseif action_id == hash("right") then
		if action.pressed then
			inputTable[4] = true
		elseif action.released then
			inputTable[4] = false
		end
	elseif action_id == hash("action1") then
		text = true
		if interact[1] ~= "" then
			msg.post("main:/gui#main", "text", {interact})
		end
		--talking/interact
	elseif action_id == hash("action2") and action.pressed and not rollCd then
		roll = true
		rollCd = true
		timer.delay(.1, false, function()
			roll = false
		end)
		timer.delay(.5, false, function()
			rollCd = false
		end)
		--dash
	elseif action_id == hash("action3") and menuCd then
		menu = not menu
		msg.post("main:/gui#main", "menu", {menu})
		menuCd = false
		timer.delay(1, false, function()
			menuCd = true
		end)
		--menu
	elseif action_id == hash("phase") and action.pressed then
		if not inWall then
			phase = not phase
			if phase then
				go.set_position(vmath.vector3(0, 0, 0), "/go")
			else
				go.set_position(vmath.vector3(0, 0, -1), "/go")
			end
		end
		--phase switch
	end	
end

