local velocity = vmath.vector3()

local inputTable = {
	false,
	false,
	false,
	false
}

function init(self)
	msg.post("/player#camera", "acquire_camera_focus")
	msg.post(".", "acquire_input_focus")
	velocity = vmath.vector3()
end

function update(self, dt)
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	velocity.x = 0
	velocity.y = 0
	if inputTable[1] and inputTable[2] then

	elseif inputTable[1] then
			velocity.y = velocity.y + 5
	elseif inputTable[2] then
			velocity.y = velocity.y - 5
	end
	if inputTable[3] and inputTable[4] then

	elseif inputTable[3] then
			velocity.x = velocity.x - 5
	elseif inputTable[4] then
			velocity.x = velocity.x + 5
	end
	if math.sqrt(velocity.x ^ 2 + velocity.y ^ 2) > 0 then
		go.set_position(go.get_position() + velocity)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("contact_point_response") then
		if message.group == hash("wall") then
			go.set_position()
		end
	end
end

--inputTable 1 = up 2 = down 3 = left 4 = right

function on_input(self, action_id, action)
	if action_id == hash("up") then
		if action.pressed then
			inputTable[1] = true
		elseif action.released then
			inputTable[1] = false
		end
	elseif action_id == hash("down") then
		if action.pressed then
			inputTable[2] = true
		elseif action.released then
			inputTable[2] = false
		end
	end
	if action_id == hash("left") then
		if action.pressed then
			inputTable[3] = true
		elseif action.released then
			inputTable[3] = false
		end
	elseif action_id == hash("right") then
		if action.pressed then
			inputTable[4] = true
		elseif action.released then
			inputTable[4] = false
		end
	end	
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
