local velocity = vmath.vector3()
local moveMulti = 1

local roll = false
local rollCd = false
local menu = false
local menuCd = true
local text = false

local pickup = false
local box = nil

local interact = {"", ""}
local npcs = require("assets.scripts.npcs")

-- true = normal false = astral
local phase = true

local inputTable = {
	false,
	false,
	false,
	false
}
local lastInput = "down"
local currAnim = ""

local function sign(n)
	if n > 0 then
		return 1
	elseif n < 0 then
		return -1
	else
		return 0
	end
end

local offset = vmath.vector3(0, 64, 0)

local function changeAnim(input)
	if phase and input ~= currAnim then
		sprite.play_flipbook("#sprite", input)
		currAnim = input
	elseif not phase then

	end
end

local boxVel = vmath.vector3()

local function dropBox()
	if pickup then
		boxVel.x = 0
		boxVel.y = 0
		pickup = false
		if lastInput == "left" then
			boxVel.x = -32
		elseif lastInput == "down" then
			boxVel.y = -32
		elseif lastInput == "up" then
			boxVel.y = 32
		else
			boxVel.x = 32
		end
		local bCheck = physics.raycast(go.get_position(), go.get_position() + boxVel, {hash("wall")})
		local pCheck = physics.raycast(go.get_position(), go.get_position() - boxVel, {hash("wall")})		
		if bCheck and bCheck.id ~= hash("/astralWall") then
			boxVel.x = boxVel.x * bCheck.fraction
			boxVel.y = boxVel.y * bCheck.fraction
		end
		if pCheck then
			pickup = true
		else
			go.set_position(go.get_position() + boxVel, box)
			msg.post(box, "pickup", {pickup})
			box = nil
		end
	end
end

local function move(vel)
	if math.sqrt(vel.x ^ 2 + vel.y ^ 2) > 0 then
		if vel.x ~= 0 then
			local xHit = physics.raycast(go.get_position(), go.get_position() + vmath.vector3(vel.x + (sign(vel.x) * 17), 0, 0), {hash("wall")})
			if xHit and ((xHit.id ~= hash("/normalWall") and xHit.id ~= hash("/astralWall")) or (phase and xHit.id == hash("/normalWall")) or (not phase and xHit.id == hash("/astralWall"))) then
				vel.x = sign(vel.x) * ((math.abs(vel.x) + 10) * xHit.fraction - 10)
			end
		end
		if vel.y ~= 0 then
			local yHit = physics.raycast(go.get_position(), go.get_position() + vmath.vector3(0, vel.y + (sign(vel.y) * 17), 0), {hash("wall")})
			if yHit and ((yHit.id ~= hash("/normalWall") and yHit.id ~= hash("/astralWall")) or (phase and yHit.id == hash("/normalWall")) or (not phase and yHit.id == hash("/astralWall"))) then
				vel.y = sign(vel.y) * ((math.abs(vel.y) + 10) * yHit.fraction - 10)
			end
		end
		go.set_position(go.get_position() + vel)
		if pickup then
			go.set_position(go.get_position() + offset, box)
		end
		changeAnim(lastInput .. "Walk")
	else
		changeAnim(lastInput .. "Idle")
	end
end

function init(self)
	msg.post("/go#camera", "acquire_camera_focus")
	msg.post(".", "acquire_input_focus")
	velocity = vmath.vector3()
	playerPos = vmath.vector3()

end

function update(self, dt)
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

local inWall = false

function fixed_update(self, dt)
	collisionCount = 0
	if menu or text then
		if npcs.offNpc(false) then
			text = false
		end
	elseif roll then
		move(velocity * 3 * moveMulti)
	else
		velocity.x = 0
		velocity.y = 0
		if inputTable[1] and inputTable[2] then

		elseif inputTable[1] then
			velocity.y = velocity.y + 3
			lastInput = "up"
		elseif inputTable[2] then
			velocity.y = velocity.y - 3
			lastInput = "down"
		end
		if inputTable[3] and inputTable[4] then

		elseif inputTable[3] then
			velocity.x = velocity.x - 3
			lastInput = "left"
		elseif inputTable[4] then
			velocity.x = velocity.x + 3
			lastInput = "right"
		end
		move(velocity * moveMulti)
		inWall = false
		interact[1] = ""
		interact[2] = ""
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("contact_point_response") then
		if message.group == hash("wall") and math.floor(message.distance) > 0 then
			inWall = true
			if (message.other_id ~= hash("/normalWall") and message.other_id ~= hash("/astralWall")) or (phase and message.other_id == hash("/normalWall")) or (not phase and message.other_id == hash("/astralWall")) then
				go.set_position(go.get_position() + (message.normal * message.distance))
			end
		else
			inWall = false
		end
		if phase and message.group == hash("npc") then
			interact[1] = "npc"
			interact[2] = message.other_id
		elseif message.group == hash("interact") then
			interact[1] = "interact"
			interact[2] = message.other_id
		elseif message.group == hash("box") and not pickup then
			interact[1] = "box"
			interact[2] = message.other_id
		end
	elseif message_id == hash("text") then
		text = false
	end
end

--inputTable 1 = up 2 = down 3 = left 4 = right

function on_input(self, action_id, action)
	if action_id == hash("up") then
		if action.pressed then
			inputTable[1] = true
		elseif action.released then
			inputTable[1] = false
		end
	elseif action_id == hash("down") then
		if action.pressed then
			inputTable[2] = true
		elseif action.released then
			inputTable[2] = false
		end
	end
	if action_id == hash("left") then
		if action.pressed then
			inputTable[3] = true
		elseif action.released then
			inputTable[3] = false
		end
	elseif action_id == hash("right") then
		if action.pressed then
			inputTable[4] = true
		elseif action.released then
			inputTable[4] = false
		end
	elseif action_id == hash("action1") and action.pressed and not menu and not text then
		if interact[1] ~= "" then
			if phase and interact[1] == "box" then
				pickup = true
				box = interact[2]
				go.set_position(go.get_position() + offset, box)
				msg.post(box, "pickup", {pickup})
			elseif interact[1] ~= "box" then
				text = true
				msg.post("main:/gui#main", "talk", {interact})
				msg.post(interact[2], "talk")
			end
		elseif pickup then
			dropBox()
		end
		--talking/interact
	elseif action_id == hash("action2") and action.pressed and not rollCd and not menu and not text then
		roll = true
		rollCd = true
		msg.post("#sprite", "disable")
		timer.delay(.1, false, function()
			msg.post("#sprite", "enable")
			roll = false
		end)
		timer.delay(.5, false, function()
			rollCd = false
		end)
		--dash
	elseif action_id == hash("action3") and menuCd and not text then
		menu = not menu
		msg.post("main:/gui#main", "menu", {menu})
		menuCd = false
		timer.delay(1, false, function()
			menuCd = true
		end)
		--menu
	elseif action_id == hash("phase") and action.pressed and not menu and not text then
		if not inWall then
			dropBox()
			phase = not phase
			if phase then
				go.set_position(vmath.vector3(0, 0, 0), "/go")
				moveMulti = 1
			else
				go.set_position(vmath.vector3(0, 0, -1), "/go")
				moveMulti = 1.5
			end
		else
			msg.post("main:/gui#main", "unable", {})
		end
		--phase switch
	end	
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
